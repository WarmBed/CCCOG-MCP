<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <Platforms>x64;ARM64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>CCCOG.Bar.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Task 7 (2026-08-17): the exe's own icon (Explorer/taskbar/alt-tab
         before the tray TaskbarIcon even loads) — generated by
         bar/tools/generate_tray_icon.py, not hand-placed art. Same file the
         TaskbarIcon.IconSource in App.xaml.cs points to at runtime, so both
         match. -->
    <ApplicationIcon>Assets\tray-icon.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.8.*" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.*" />
    <PackageReference Include="H.NotifyIcon.WinUI" Version="2.*" />
  </ItemGroup>
  <ItemGroup>
    <!-- Copied next to the exe so App.xaml.cs can load it via a plain
         AppContext.BaseDirectory-relative file path at runtime (this is an
         unpackaged WindowsAppSDK app — no ms-appx:/// package identity to
         resolve a pack URI against). -->
    <Content Include="Assets\tray-icon.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
  <Target Name="CopyCccogBarFfi" AfterTargets="Build"
          Condition="Exists('$(MSBuildThisFileDirectory)..\..\target\release\cccog_bar_ffi.dll')">
    <Copy SourceFiles="$(MSBuildThisFileDirectory)..\..\target\release\cccog_bar_ffi.dll"
          DestinationFolder="$(TargetDir)"
          SkipUnchangedFiles="true" />
  </Target>
  <!-- A RID-less build writes only the base output folder; the RID-specific
       win-x64\ subfolder holds an independently launchable copy of the app that
       would otherwise keep serving whatever was built there last, with no error
       or version-mismatch warning (bar/SYNC.md, 2026-08-16). When that folder
       exists, rebuild it too so both exes always come from the same sources.
       The inner build has RuntimeIdentifier set, so this target cannot recurse;
       CopyCccogBarFfi runs inside it with the RID-specific $(TargetDir). -->
  <Target Name="SyncWinX64RidOutput" AfterTargets="Build"
          Condition="'$(RuntimeIdentifier)' == '' and Exists('$(TargetDir)win-x64')">
    <MSBuild Projects="$(MSBuildProjectFullPath)" Targets="Build"
             Properties="RuntimeIdentifier=win-x64;Configuration=$(Configuration);Platform=$(Platform)" />
  </Target>
</Project>

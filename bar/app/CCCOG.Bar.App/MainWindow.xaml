<Window
    x:Class="CCCOG.Bar.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Padding="16" Background="#F9131824">
        <Grid.Resources>
            <Style TargetType="TextBlock">
                <Setter Property="Foreground" Value="#F8FAFC" />
            </Style>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Spacing="8">
            <StackPanel Spacing="2">
                <TextBlock Text="CCCOG-Bar" FontSize="24" FontWeight="SemiBold" />
                <TextBlock Text="Live control graph - read-only local snapshot" Opacity="0.72" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="8">
                <ComboBox x:Name="ProviderFilter" Width="130"
                          Header="Provider" SelectedIndex="0"
                          SelectionChanged="ProviderFilter_SelectionChanged">
                    <ComboBoxItem Content="All" Tag="all" />
                    <ComboBoxItem Content="Claude" Tag="claude" />
                    <ComboBoxItem Content="Codex" Tag="codex" />
                    <ComboBoxItem Content="Grok" Tag="grok" />
                </ComboBox>
                <ComboBox x:Name="TimeFilter" Width="160"
                          Header="Window" SelectedIndex="0"
                          SelectionChanged="TimeFilter_SelectionChanged">
                    <ComboBoxItem Content="Active + 2h" Tag="2h" />
                    <ComboBoxItem Content="Last 24h" Tag="24h" />
                    <ComboBoxItem Content="All history" Tag="all" />
                </ComboBox>
                <Button Content="Refresh" Click="Refresh_Click" VerticalAlignment="Bottom" />
            </StackPanel>
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,16,0,12" ColumnSpacing="14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="*" MinWidth="250" />
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" BorderBrush="#405B6B7A" BorderThickness="1" CornerRadius="8" Padding="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="Control flow" FontSize="17" FontWeight="SemiBold" />
                    <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                        <Canvas x:Name="GraphCanvas" Width="400" Height="430" />
                    </ScrollViewer>
                </Grid>
            </Border>
            <Border Grid.Column="1" BorderBrush="#405B6B7A" BorderThickness="1" CornerRadius="8" Padding="10">
                <StackPanel Spacing="10">
                    <TextBlock Text="Quota" FontSize="17" FontWeight="SemiBold" />
                    <TextBlock Text="Provider cards use local usage files or approved read-only quota endpoints."
                               Opacity="0.72" />
                    <ItemsControl x:Name="QuotaCardsList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Spacing="4" Margin="0,4,0,6">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Text="{Binding Label}" FontWeight="SemiBold" Foreground="#F8FAFC" />
                                        <TextBlock Text="{Binding UsedText}"
                                                   Foreground="#F8FAFC" />
                                    </StackPanel>
                                    <ProgressBar Maximum="100" Value="{Binding UsedPercent}" Height="8" />
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="{Binding ResetText}" FontSize="11" Opacity="0.72"
                                                   Foreground="#F8FAFC" />
                                        <TextBlock Text="{Binding StateText}" FontSize="11" Opacity="0.72"
                                                   Foreground="#F8FAFC" TextWrapping="Wrap" />
                                    </StackPanel>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </Grid>

        <StackPanel Grid.Row="2" Spacing="2">
            <TextBlock x:Name="StatusText" Text="Loading snapshot…" Opacity="0.72" />
            <TextBlock x:Name="DetailsText" Text="Select an edge to inspect its task summary." Opacity="0.72"
                       MaxLines="2" TextTrimming="CharacterEllipsis" />
            <TextBlock Text="Tokens only - no cost calculation" Opacity="0.72" />
        </StackPanel>
    </Grid>
</Window>

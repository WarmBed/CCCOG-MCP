<Window
    x:Class="CCCOG.Bar.App.FlyoutWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Padding="14,12,14,10" Background="#F9131824">
        <Grid.Resources>
            <Style TargetType="TextBlock">
                <Setter Property="Foreground" Value="#F8FAFC" />
            </Style>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="280" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8" Margin="0,0,0,10">
            <StackPanel Spacing="2">
                <TextBlock Text="CCCOG" FontSize="18" FontWeight="SemiBold" />
                <TextBlock x:Name="RefreshedText" Text="Refreshing..." FontSize="10" Opacity="0.65" />
            </StackPanel>
            <Button x:Name="RefreshButton" Width="28" Height="28"
                    Padding="0" Background="Transparent" BorderThickness="0"
                    VerticalAlignment="Center" ToolTipService.ToolTip="Refresh">
                <FontIcon Glyph="&#xE72C;" FontSize="12" Opacity="0.8" />
            </Button>
        </StackPanel>

        <ItemsControl x:Name="QuotaCardsList" Grid.Row="1" Margin="0,0,0,10">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Background="#1AFFFFFF" BorderBrush="#334A5568" BorderThickness="1"
                            CornerRadius="6" Padding="8,6" Margin="0,0,0,5">
                        <StackPanel Spacing="4">
                            <Grid ColumnDefinitions="*,Auto">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="{Binding Label}" FontSize="12" FontWeight="SemiBold"
                                               Foreground="#F8FAFC" />
                                    <TextBlock Text="{Binding UsedText}" FontSize="11" Foreground="#F8FAFC" />
                                </StackPanel>
                            </Grid>
                            <ProgressBar Maximum="100" Value="{Binding UsedPercent}" Height="6" />
                            <StackPanel Spacing="2">
                                <TextBlock Text="{Binding ResetText}" FontSize="10" Opacity="0.65"
                                           Foreground="#F8FAFC" />
                                <TextBlock Text="{Binding StateText}" FontSize="10" Opacity="0.65"
                                           Foreground="#F8FAFC"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Border Grid.Row="2" Background="#12000000" BorderBrush="#334A5568" BorderThickness="1"
                CornerRadius="6" Padding="8,7" Margin="0,0,0,8">
            <Grid RowDefinitions="Auto,*">
                <TextBlock Text="Control relations" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,5" />
                <ScrollViewer Grid.Row="1" MaxHeight="270" VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="RelationList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#12FFFFFF" CornerRadius="4" Padding="6,5" Margin="0,0,0,4"
                                        ToolTipService.ToolTip="{Binding TaskSummary}">
                                    <Grid ColumnDefinitions="Auto,*,Auto">
                                        <Ellipse Width="7" Height="7" VerticalAlignment="Center"
                                                 Fill="{Binding StatusBrush}" />
                                        <StackPanel Grid.Column="1" Margin="6,0,4,0" Spacing="1">
                                            <TextBlock Text="{Binding Label}" FontSize="11"
                                                       Foreground="#F8FAFC" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding AgeText}" FontSize="10" Opacity="0.62"
                                                       Foreground="#F8FAFC" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="2" Text="{Binding CountText}" FontSize="11"
                                                   Foreground="#F8FAFC" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>

        <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="8">
            <TextBlock x:Name="StatusText" Text="0 edges - tokens only" FontSize="10" Opacity="0.6"
                       VerticalAlignment="Center" />
            <Button x:Name="ExpandButton" Content="Expand full graph" FontSize="11"
                    Padding="8,3" Background="Transparent" />
        </StackPanel>
    </Grid>
</Window>

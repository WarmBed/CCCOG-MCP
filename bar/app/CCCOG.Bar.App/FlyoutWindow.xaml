<Window
    x:Class="CCCOG.Bar.App.FlyoutWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:CCCOG.Bar.App">

    <!-- Ported verbatim (namespace only) from TokenBar-Windows
         src/TokenBar.App/FlyoutWindow.xaml. -->
    <Grid>
        <local:DashboardView x:Name="Dashboard" />
        <!-- Top-edge resize grabber (the macOS footer drag handle, flipped:
             this flyout hangs from the taskbar so it grows upward). Ported
             as a structural/hover-only element — see bar/SYNC.md for why
             drag-to-resize itself was not carried over (TokenBar persists
             the dragged height via AppSettings.Store, which CCCOG's shell
             does not have). -->
        <Border
            x:Name="ResizeGrip"
            VerticalAlignment="Top"
            Height="8"
            Background="Transparent">
            <Border
                x:Name="ResizeGripHint"
                Width="36"
                Height="3"
                CornerRadius="1.5"
                VerticalAlignment="Center"
                Opacity="0"
                Background="{ThemeResource TextFillColorTertiaryBrush}" />
        </Border>
    </Grid>
</Window>

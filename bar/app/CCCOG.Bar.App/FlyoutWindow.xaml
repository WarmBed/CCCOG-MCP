<Window
    x:Class="CCCOG.Bar.App.FlyoutWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Mica/Acrylic supplies the blur; this tint keeps quota/flow text
         legible over any desktop wallpaper (a live/animated wallpaper
         behind a bare-transparent panel measured unreadable in the real
         90s run — see docs/plans/2026-08-16-cccog-bar-v2-slim.md). -->
    <Grid x:Name="RootGrid" Padding="16,14,16,10" Background="#CC131824">
        <Grid.Resources>
            <Style TargetType="TextBlock">
                <Setter Property="Foreground" Value="#F8FAFC" />
            </Style>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8" Margin="0,0,0,10">
            <StackPanel Spacing="2">
                <TextBlock Text="CCCOG" FontSize="19" FontWeight="SemiBold" />
                <TextBlock x:Name="RefreshedText" Text="Refreshing…" FontSize="10" Opacity="0.65" />
            </StackPanel>
            <Button x:Name="RefreshButton" Width="28" Height="28"
                    Padding="0" Background="Transparent" BorderThickness="0"
                    VerticalAlignment="Center" ToolTipService.ToolTip="Refresh">
                <FontIcon Glyph="&#xE72C;" FontSize="12" Opacity="0.8" />
            </Button>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="10">

                <!-- Section 1: quota cards. Always in the tree — a loading
                     line stands in for missing data instead of hiding the
                     section (lessons-learned #1). -->
                <Border Background="#12FFFFFF" BorderBrush="#334A5568" BorderThickness="1"
                        CornerRadius="8" Padding="10,8">
                    <StackPanel Spacing="6">
                        <TextBlock Text="Quota" FontSize="13" FontWeight="SemiBold" />
                        <TextBlock x:Name="QuotaLoadingText" Text="Loading quota…" FontSize="11"
                                   Opacity="0.6" />
                        <ItemsControl x:Name="QuotaCardsList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#1AFFFFFF" BorderBrush="{Binding AccentBrush}"
                                            BorderThickness="0,0,0,2" CornerRadius="6" Padding="8,6"
                                            Margin="0,0,0,5">
                                        <StackPanel Spacing="4">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <TextBlock Text="{Binding Label}" FontSize="12"
                                                           FontWeight="SemiBold" Foreground="#F8FAFC" />
                                                <TextBlock Text="{Binding UsedText}" FontSize="11"
                                                           Foreground="#F8FAFC" />
                                            </StackPanel>
                                            <ProgressBar Maximum="100" Value="{Binding UsedPercent}" Height="5" />
                                            <TextBlock Text="{Binding ResetText}" FontSize="10" Opacity="0.65"
                                                       Foreground="#F8FAFC" />
                                            <TextBlock Text="{Binding StateText}" FontSize="10" Opacity="0.8"
                                                       Foreground="#F8FAFC" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- Section 2: flow rows. Same always-visible discipline. -->
                <Border Background="#12FFFFFF" BorderBrush="#334A5568" BorderThickness="1"
                        CornerRadius="8" Padding="10,8">
                    <StackPanel Spacing="6">
                        <TextBlock Text="Flow" FontSize="13" FontWeight="SemiBold" />
                        <TextBlock x:Name="FlowLoadingText" Text="Loading flow…" FontSize="11"
                                   Opacity="0.6" />
                        <TextBlock x:Name="FlowEmptyText" Text="No active or recent jobs" FontSize="11"
                                   Opacity="0.6" Visibility="Collapsed" />
                        <ItemsControl x:Name="RowsList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#10FFFFFF" CornerRadius="4" Padding="6,5"
                                            Margin="0,0,0,4" ToolTipService.ToolTip="{Binding TaskSummary}">
                                        <Grid ColumnDefinitions="Auto,*">
                                            <Ellipse x:Name="StatusDot" Width="8" Height="8"
                                                     VerticalAlignment="Center"
                                                     Fill="{Binding DotBrush}"
                                                     Opacity="{Binding DotOpacity}" />
                                            <StackPanel Grid.Column="1" Margin="7,0,4,0" Spacing="1">
                                                <TextBlock Text="{Binding ChainText}" FontSize="11"
                                                           Foreground="{Binding LabelBrush}"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding MetaText}" FontSize="10" Opacity="0.62"
                                                           Foreground="#F8FAFC" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
            <TextBlock x:Name="StatusText" Text="0 rows - tokens only" FontSize="10" Opacity="0.6"
                       VerticalAlignment="Center" />
        </StackPanel>
    </Grid>
</Window>

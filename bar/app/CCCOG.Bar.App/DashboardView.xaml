<UserControl
    x:Class="CCCOG.Bar.App.DashboardView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Ported from TokenBar-Windows src/TokenBar.App/DashboardView.xaml
         (namespace only): same Grid Padding/RowSpacing, same header Grid
         shape (title left, refresh button+spinner right in a 26x26 overlay
         Grid), same ScrollViewer/ContentPresenter section pattern, same
         footer row (status text left, Quit hugging the right edge — the
         gear was dropped, see bar/SYNC.md). See bar/SYNC.md for what else
         was dropped and why (year filter, client tabs, today/total/rate
         stat row, 3D graph host — none of those exist in CCCOG's
         Flow-then-Quota shell) and Ui.cs for the ported card/row
         primitives this view's code-behind builds with.

         Row order (operator layout pass): Flow on top (scrollable — it's
         the section with unbounded row count), Quota at the bottom as
         three fixed-order side-by-side cards (Claude / Codex / Grok),
         footer under the quota row. -->
    <Grid Padding="16,14,16,10" RowSpacing="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Spacing="6">
            <Grid>
                <TextBlock
                    FontSize="15"
                    FontWeight="SemiBold"
                    VerticalAlignment="Center"
                    Text="CCCOG" />
                <Grid VerticalAlignment="Center" HorizontalAlignment="Right" Width="26" Height="26">
                    <Button
                        x:Name="RefreshButton"
                        Padding="0"
                        Width="26"
                        Height="26"
                        Background="Transparent"
                        BorderThickness="0"
                        ToolTipService.ToolTip="Refresh">
                        <FontIcon Glyph="&#xE72C;" FontSize="11" Opacity="0.75" />
                    </Button>
                    <ProgressRing
                        x:Name="RefreshSpinner"
                        Width="15"
                        Height="15"
                        IsActive="False"
                        Visibility="Collapsed" />
                </Grid>
            </Grid>
            <TextBlock x:Name="RefreshedText" Opacity="0.65" FontSize="11" Text="refreshing…" />
        </StackPanel>

        <!-- Flow section (top): TokenBar's ScrollViewer + ContentPresenter
             pattern. x:Name="CardsScroll" matches TokenBar's own naming —
             the WH_MOUSE_LL wheel-focus workaround (FlyoutWindow.xaml.cs)
             routes into this ScrollViewer via RouteGlobalWheel/ScrollBy. -->
        <ScrollViewer
            x:Name="CardsScroll"
            Grid.Row="1"
            VerticalScrollBarVisibility="Auto"
            VerticalScrollMode="Enabled"
            IsVerticalScrollChainingEnabled="False">
            <ContentPresenter x:Name="FlowHost" />
        </ScrollViewer>

        <!-- Quota section (bottom): three equal-width, fixed-order cards —
             left/center/right = Claude/Codex/Grok — instead of one grouped
             card. Each host renders independently so a still-loading
             provider never blanks the whole row (lessons-learned #1). -->
        <Grid Grid.Row="2" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <ContentPresenter x:Name="ClaudeQuotaHost" Grid.Column="0" />
            <ContentPresenter x:Name="CodexQuotaHost" Grid.Column="1" />
            <ContentPresenter x:Name="GrokQuotaHost" Grid.Column="2" />
        </Grid>

        <!-- Footer: TokenBar's footer pattern (status text, left-aligned,
             opacity 0.5, FontSize 10) plus a Quit button hugging the right
             edge (TokenBar's Padding/FontSize/Background/BorderThickness,
             verbatim). No gear — CCCOG has no settings window. -->
        <Grid Grid.Row="3">
            <TextBlock
                x:Name="FooterText"
                VerticalAlignment="Center"
                Opacity="0.5"
                FontSize="10"
                Text="" />
            <StackPanel
                Orientation="Horizontal"
                Spacing="2"
                HorizontalAlignment="Right">
                <Button
                    x:Name="QuitButton"
                    Padding="7,2,7,3"
                    FontSize="11"
                    Background="Transparent"
                    BorderThickness="0"
                    Content="Quit" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
